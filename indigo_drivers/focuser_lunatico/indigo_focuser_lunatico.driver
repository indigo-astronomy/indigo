				}
			}
			item X_ROTATOR_MOTOR_WIRING_EXP_LUNATICO { name = "LUNATICO"; label = "Lunatico"; value = true; }
			item X_ROTATOR_MOTOR_WIRING_EXP_MOONLITE { name = "MOONLITE"; label = "RF/Moonlite"; value = false; }
		}
		switch X_ROTATOR_MOTOR_TYPE_EXP {
			name = "X_ROTATOR_MOTOR_TYPE";
			group = ROTATOR_ADVANCED_GROUP;
			label = "Motor type";
			rule = INDIGO_ONE_OF_MANY_RULE;
			persistent = true;
			on_change {
