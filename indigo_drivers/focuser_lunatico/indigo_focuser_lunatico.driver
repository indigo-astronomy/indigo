			group = ROTATOR_ADVANCED_GROUP;
			label = "Coils current control";
			persistent = true;
			on_change {
				if (!lunatico_apply_power_control(device, X_ROTATOR_POWER_CONTROL_EXP_PROPERTY)) {
					X_ROTATOR_POWER_CONTROL_EXP_PROPERTY->state = INDIGO_ALERT_STATE;
				}
			}
			item X_ROTATOR_POWER_CONTROL_EXP_MOVE { name = "MOVE_POWER"; label = "Move power (%)"; min = 0; max = 100; step = 1; value = 100; }
			item X_ROTATOR_POWER_CONTROL_EXP_STOP { name = "STOP_POWER"; label = "Stop power (%)"; min = 0; max = 100; step = 1; value = 0; }
		}
		switch X_ROTATOR_MOTOR_WIRING_EXP {
			name = "X_ROTATOR_MOTOR_WIRING";
			group = ROTATOR_ADVANCED_GROUP;
			label = "Motor wiring";
