			group = ROTATOR_ADVANCED_GROUP;
			label = "Motor wiring";
			rule = INDIGO_ONE_OF_MANY_RULE;
			persistent = true;
			on_change {
				if (!lunatico_apply_wiring(device, X_ROTATOR_MOTOR_WIRING_THIRD_PROPERTY, !ROTATOR_DIRECTION_NORMAL_ITEM->sw.value)) {
					X_ROTATOR_MOTOR_WIRING_THIRD_PROPERTY->state = INDIGO_ALERT_STATE;
				}
			}
			item X_ROTATOR_MOTOR_WIRING_THIRD_LUNATICO { name = "LUNATICO"; label = "Lunatico"; value = true; }
			item X_ROTATOR_MOTOR_WIRING_THIRD_MOONLITE { name = "MOONLITE"; label = "RF/Moonlite"; value = false; }
		}
		switch X_ROTATOR_MOTOR_TYPE_THIRD {
			name = "X_ROTATOR_MOTOR_TYPE";
			group = ROTATOR_ADVANCED_GROUP;
			label = "Motor type";
			rule = INDIGO_ONE_OF_MANY_RULE;
			persistent = true;
			on_change {
				if (!lunatico_apply_motor_type(device, X_ROTATOR_MOTOR_TYPE_THIRD_PROPERTY)) {
					X_ROTATOR_MOTOR_TYPE_THIRD_PROPERTY->state = INDIGO_ALERT_STATE;
				}
			}
			item X_ROTATOR_MOTOR_TYPE_THIRD_UNIPOLAR { name = "UNIPOLAR"; label = "Unipolar"; value = true; }
			item X_ROTATOR_MOTOR_TYPE_THIRD_BIPOLAR { name = "BIPOLAR"; label = "Bipolar"; value = false; }
			item X_ROTATOR_MOTOR_TYPE_THIRD_DC { name = "DC"; label = "DC"; value = false; }
			item X_ROTATOR_MOTOR_TYPE_THIRD_STEP_DIR { name = "STEP_DIR"; label = "Step-dir"; value = false; }
		}
	}

	aux {
		id = aux_third;
		name = "Powerbox Lunatico (Third)";
		interface = INDIGO_INTERFACE_AUX_GPIO | INDIGO_INTERFACE_AUX_POWERBOX;
		on_attach {
			device->gp_bits = 2;
			INFO_PROPERTY->count = 6;
		}
		on_connect {
			connection_result = lunatico_aux_connect(device, AUX_POWER_OUTLET_THIRD_PROPERTY);
		}
		on_disconnect {
			lunatico_release_port(device);
		}
		on_timer {
			lunatico_poll_sensors(device, AUX_GPIO_SENSORS_THIRD_PROPERTY);
			indigo_execute_handler_in(device, LUNATICO_SENSOR_POLL, aux_third_timer_callback);
		}
		text AUX_OUTLET_NAMES_THIRD {
			name = AUX_OUTLET_NAMES_PROPERTY_NAME;
			group = AUX_POWERBOX_GROUP;
			label = "Power outlet names";
			always_defined = true;
			persistent = true;
			on_change {
				lunatico_apply_names(device, AUX_OUTLET_NAMES_THIRD_PROPERTY, AUX_POWER_OUTLET_THIRD_PROPERTY);
			}
			item AUX_OUTLET_NAME_THIRD_1 { name = AUX_POWER_OUTLET_NAME_1_ITEM_NAME; label = "DB9 Pin 1"; value = "Power #1"; }
			item AUX_OUTLET_NAME_THIRD_2 { name = AUX_POWER_OUTLET_NAME_2_ITEM_NAME; label = "DB9 Pin 2"; value = "Power #2"; }
			item AUX_OUTLET_NAME_THIRD_3 { name = AUX_POWER_OUTLET_NAME_3_ITEM_NAME; label = "DB9 Pin 3"; value = "Power #3"; }
			item AUX_OUTLET_NAME_THIRD_4 { name = AUX_POWER_OUTLET_NAME_4_ITEM_NAME; label = "DB9 Pin 4"; value = "Power #4"; }
		}
		switch AUX_POWER_OUTLET_THIRD {
			name = AUX_POWER_OUTLET_PROPERTY_NAME;
			group = AUX_POWERBOX_GROUP;
			label = "Power outlets";
			rule = INDIGO_ANY_OF_MANY_RULE;
			on_change {
				if (!lunatico_apply_outlets(device, AUX_POWER_OUTLET_THIRD_PROPERTY)) {
					AUX_POWER_OUTLET_THIRD_PROPERTY->state = INDIGO_ALERT_STATE;
				}
			}
			item AUX_POWER_OUTLET_THIRD_1 { name = AUX_POWER_OUTLET_1_ITEM_NAME; label = "Power #1"; value = false; }
			item AUX_POWER_OUTLET_THIRD_2 { name = AUX_POWER_OUTLET_2_ITEM_NAME; label = "Power #2"; value = false; }
			item AUX_POWER_OUTLET_THIRD_3 { name = AUX_POWER_OUTLET_3_ITEM_NAME; label = "Power #3"; value = false; }
			item AUX_POWER_OUTLET_THIRD_4 { name = AUX_POWER_OUTLET_4_ITEM_NAME; label = "Power #4"; value = false; }
		}
		text AUX_SENSOR_NAMES_THIRD {
			name = AUX_SENSOR_NAMES_PROPERTY_NAME;
			group = AUX_SENSORS_GROUP;
			label = "Sensor names";
			always_defined = true;
			persistent = true;
			on_change {
				lunatico_apply_names(device, AUX_SENSOR_NAMES_THIRD_PROPERTY, AUX_GPIO_SENSORS_THIRD_PROPERTY);
			}
			item AUX_SENSOR_NAME_THIRD_1 { name = AUX_GPIO_SENSOR_NAME_1_ITEM_NAME; label = "DB9 Pin 6"; value = "Sensor #1"; }
			item AUX_SENSOR_NAME_THIRD_2 { name = AUX_GPIO_SENSOR_NAME_2_ITEM_NAME; label = "DB9 Pin 7"; value = "Sensor #2"; }
			item AUX_SENSOR_NAME_THIRD_3 { name = AUX_GPIO_SENSOR_NAME_3_ITEM_NAME; label = "DB9 Pin 8"; value = "Sensor #3"; }
			item AUX_SENSOR_NAME_THIRD_4 { name = AUX_GPIO_SENSOR_NAME_4_ITEM_NAME; label = "DB9 Pin 9"; value = "Sensor #4"; }
		}
		number AUX_GPIO_SENSORS_THIRD {
			name = AUX_GPIO_SENSORS_PROPERTY_NAME;
			group = AUX_SENSORS_GROUP;
			label = "GPIO sensors";
			perm = INDIGO_RO_PERM;
			item AUX_GPIO_SENSOR_THIRD_1 { name = AUX_GPIO_SENSOR_NAME_1_ITEM_NAME; label = "Sensor #1"; min = 0; max = 1024; step = 1; value = 0; }
			item AUX_GPIO_SENSOR_THIRD_2 { name = AUX_GPIO_SENSOR_NAME_2_ITEM_NAME; label = "Sensor #2"; min = 0; max = 1024; step = 1; value = 0; }
			item AUX_GPIO_SENSOR_THIRD_3 { name = AUX_GPIO_SENSOR_NAME_3_ITEM_NAME; label = "Sensor #3"; min = 0; max = 1024; step = 1; value = 0; }
			item AUX_GPIO_SENSOR_THIRD_4 { name = AUX_GPIO_SENSOR_NAME_4_ITEM_NAME; label = "Sensor #4"; min = 0; max = 1024; step = 1; value = 0; }
		}
	}

}
