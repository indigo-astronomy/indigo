	focuser {
		id = focuser_2;
		name = "Optec FocusLynx #2";
		on_attach {
			// The logical focuser number addresses the hub and indexes the
			// shared per focuser state.
			device->gp_bits = 2;
			INFO_PROPERTY->count = 6;
			INDIGO_COPY_VALUE(INFO_DEVICE_MODEL_ITEM->text.value, "FocusLynx");
		}
		on_connect {
			connection_result = optecfl_connect(device);
		}
		on_timer {
			optecfl_poll(device);
			indigo_execute_handler_in(device, 1, focuser_2_timer_callback);
		}
		inherited FOCUSER_SPEED {
			hidden = true;
		}
		inherited FOCUSER_TEMPERATURE {
			hidden = false;
		}
		inherited FOCUSER_REVERSE_MOTION {
			hidden = false;
		}
		inherited FOCUSER_ON_POSITION_SET {
			hidden = false;
		}
		inherited FOCUSER_LIMITS {
			hidden = false;
			on_attach {
				FOCUSER_LIMITS_MIN_POSITION_ITEM->number.min = FOCUSER_LIMITS_MIN_POSITION_ITEM->number.max = FOCUSER_LIMITS_MIN_POSITION_ITEM->number.value = 0;
			}
		}
		inherited FOCUSER_POSITION {
			preserve_values = true;
			on_attach {
				FOCUSER_POSITION_ITEM->number.min = 0;
				FOCUSER_POSITION_ITEM->number.step = 1;
			}
			// The condition also covers the BUSY guard of the generated change
			// branch, so a request that the guard would drop never reaches
			// on_change_request and cannot leave move_pending set.
			reject_change {
				condition = PRIVATE_DATA->move_pending[FOCUSER_SLOT] || FOCUSER_POSITION_PROPERTY->state == INDIGO_BUSY_STATE;
				message = "Motion already in progress";
			}
			on_change_request {
				PRIVATE_DATA->move_pending[FOCUSER_SLOT] = true;
			}
			on_change {
				optecfl_set_position(device);
			}
		}
		inherited FOCUSER_STEPS {
			on_attach {
				FOCUSER_STEPS_ITEM->number.min = 0;
				FOCUSER_STEPS_ITEM->number.max = 99999;
				FOCUSER_STEPS_ITEM->number.step = 1;
			}
			reject_change {
				condition = PRIVATE_DATA->move_pending[FOCUSER_SLOT] || FOCUSER_STEPS_PROPERTY->state == INDIGO_BUSY_STATE || FOCUSER_POSITION_PROPERTY->state == INDIGO_BUSY_STATE;
				message = "Motion already in progress";
			}
			on_change_request {
				PRIVATE_DATA->move_pending[FOCUSER_SLOT] = true;
			}
			on_change {
				optecfl_move_steps(device);
			}
		}
		inherited FOCUSER_ABORT_MOTION {
			on_change {
				// The urgent abort can overtake a move that is still queued
				// behind the polling callback.
				indigo_cancel_pending_handler(device, focuser_2_focuser_position_handler);
				indigo_cancel_pending_handler(device, focuser_2_focuser_steps_handler);
				optecfl_abort(device);
			}
		}
		switch X_FOCUSER_2_TYPE {
			name = "X_FOCUSER_TYPE";
			group = FOCUSER_MAIN_GROUP;
			label = "Focuser type";
			rule = INDIGO_ONE_OF_MANY_RULE;
			on_change {
				optecfl_apply_type(device);
			}
			item X_FOCUSER_2_TYPE_OA {
				name = "OA";
				label = "Optec TCF-Lynx 2\"";
				value = true;
			}
			item X_FOCUSER_2_TYPE_OB {
				name = "OB";
				label = "Optec TCF-Lynx 3\"";
				value = false;
			}
			item X_FOCUSER_2_TYPE_OC {
				name = "OC";
				label = "Optec TCF-Lynx 2\" with Extended Travel";
				value = false;
			}
