					ok = ok && synscan_wait_axis_stopped(device, SYNSCAN_AXIS_DEC, &PRIVATE_DATA->abort_motion);
					PRIVATE_DATA->global_mode = SYNSCAN_GLOBAL_IDLE;
					PRIVATE_DATA->homed = ok;
					if (ok) {
						synscan_clear_tracking_state(device);
					}
				}
				if (!ok) {
