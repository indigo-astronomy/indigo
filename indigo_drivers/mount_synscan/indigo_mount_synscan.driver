			// on_detach { }
		}
		inherited MOUNT_PEC {
			on_change {
				bool ok = synscan_ext_setting(device, SYNSCAN_AXIS_RA, MOUNT_PEC_ENABLED_ITEM->sw.value ? SYNSCAN_EXT_TURN_PPEC_ON : SYNSCAN_EXT_TURN_PPEC_OFF);
				if (!ok) {
					MOUNT_PEC_PROPERTY->state = INDIGO_ALERT_STATE;
				}
			}
			// on_attach { }
