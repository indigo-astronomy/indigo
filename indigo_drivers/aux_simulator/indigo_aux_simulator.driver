		switch PB_USB {
			name = AUX_USB_PORT_PROPERTY_NAME;
			group = "Main";
			label = "USB ports";
			rule = INDIGO_ANY_OF_MANY_RULE;
			on_change {
				powerbox_refresh(device, true);
			}
