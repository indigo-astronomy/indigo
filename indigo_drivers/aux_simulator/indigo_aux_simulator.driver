				name = AUX_USB_PORT_STATE_4_ITEM_NAME;
				label = "USB port #4";
				value = INDIGO_OK_STATE;
			}
		}
		number PB_HEATER {
			name = AUX_HEATER_OUTLET_PROPERTY_NAME;
			group = "Main";
			label = "Heater outputs [%]";
			on_change {
				indigo_set_switch(PB_DEW_PROPERTY, PB_DEW_MANUAL_ITEM, true);
				indigo_update_property(device, PB_DEW_PROPERTY, NULL);
				powerbox_refresh(device, true);
			}
			item PB_HEATER_1 {
				name = AUX_HEATER_OUTLET_1_ITEM_NAME;
				label = "Heater #1";
				value = 0;
				min = 0;
				max = 100;
				step = 1;
			}
			item PB_HEATER_2 {
				name = AUX_HEATER_OUTLET_2_ITEM_NAME;
				label = "Heater #2";
				value = 0;
				min = 0;
				max = 100;
				step = 1;
			}
		}
		light PB_HEATER_STATE {
			name = AUX_HEATER_OUTLET_STATE_PROPERTY_NAME;
			group = "Main";
			label = "Heater output state";
			perm = INDIGO_RO_PERM;
			item PB_HEATER_STATE_1 {
				name = AUX_HEATER_OUTLET_STATE_1_ITEM_NAME;
				label = "Heater #1";
				value = INDIGO_IDLE_STATE;
			}
			item PB_HEATER_STATE_2 {
				name = AUX_HEATER_OUTLET_STATE_2_ITEM_NAME;
				label = "Heater #2";
				value = INDIGO_IDLE_STATE;
			}
		}
		number PB_HEATER_CURRENT {
			name = AUX_HEATER_OUTLET_CURRENT_PROPERTY_NAME;
			group = "Main";
			label = "Heater current [A]";
			perm = INDIGO_RO_PERM;
			item PB_HEATER_CURRENT_1 {
				name = AUX_HEATER_OUTLET_CURRENT_1_ITEM_NAME;
				label = "Heater #1";
				value = 0;
				min = 0;
				max = 1;
				step = 0;
			}
			item PB_HEATER_CURRENT_2 {
				name = AUX_HEATER_OUTLET_CURRENT_2_ITEM_NAME;
				label = "Heater #2";
				value = 0;
				min = 0;
				max = 1;
				step = 0;
			}
		}
		switch PB_DEW {
			name = AUX_DEW_CONTROL_PROPERTY_NAME;
			group = "Main";
			label = "Dew control";
			rule = INDIGO_ONE_OF_MANY_RULE;
			on_change {
				if (PB_DEW_AUTO_ITEM->sw.value) {
					for (int i = 0; i < 2; i++) {
						PB_HEATER_PROPERTY->items[i].number.value = PB_HEATER_PROPERTY->items[i].number.target = 35;
					}
					PB_HEATER_PROPERTY->state = INDIGO_OK_STATE;
					indigo_update_property(device, PB_HEATER_PROPERTY, NULL);
				}
				powerbox_refresh(device, true);
			}
			item PB_DEW_MANUAL {
				name = AUX_DEW_CONTROL_MANUAL_ITEM_NAME;
				label = "Manual";
				value = true;
			}
			item PB_DEW_AUTO {
				name = AUX_DEW_CONTROL_AUTOMATIC_ITEM_NAME;
				label = "Automatic";
				value = false;
			}
		}
		number PB_INFO {
			name = AUX_INFO_PROPERTY_NAME;
			group = "Main";
			label = "Power sensors";
			perm = INDIGO_RO_PERM;
			item PB_INFO_VOLTAGE {
				name = AUX_INFO_VOLTAGE_ITEM_NAME;
				label = "Voltage [V]";
				value = 12.5;
				min = 0;
				max = 20;
				step = 0;
			}
			item PB_INFO_CURRENT {
				name = AUX_INFO_CURRENT_ITEM_NAME;
				label = "Current [A]";
				value = 0;
				min = 0;
				max = 30;
				step = 0;
			}
			item PB_INFO_POWER {
				name = AUX_INFO_POWER_ITEM_NAME;
				label = "Power [W]";
				value = 0;
				min = 0;
				max = 600;
				step = 0;
			}
		}
		number PB_WEATHER {
			name = AUX_WEATHER_PROPERTY_NAME;
			group = "Main";
			label = "Environment";
			perm = INDIGO_RO_PERM;
			item PB_TEMPERATURE {
				name = AUX_WEATHER_TEMPERATURE_ITEM_NAME;
				label = "Temperature [C]";
				value = 10;
				min = -50;
				max = 100;
				step = 0;
			}
			item PB_HUMIDITY {
				name = AUX_WEATHER_HUMIDITY_ITEM_NAME;
