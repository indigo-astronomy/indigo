				step = 0;
			}
			item PB_POWER_CURRENT_2 {
				name = AUX_POWER_OUTLET_CURRENT_2_ITEM_NAME;
				label = "Outlet #2";
				value = 0;
				min = 0;
				max = 10;
				step = 0;
			}
			item PB_POWER_CURRENT_3 {
				name = AUX_POWER_OUTLET_CURRENT_3_ITEM_NAME;
				label = "Outlet #3";
				value = 0;
				min = 0;
				max = 10;
				step = 0;
			}
			item PB_POWER_CURRENT_4 {
				name = AUX_POWER_OUTLET_CURRENT_4_ITEM_NAME;
				label = "Outlet #4";
