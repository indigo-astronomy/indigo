		light PB_USB_STATE {
			name = AUX_USB_PORT_STATE_PROPERTY_NAME;
			group = "Main";
			label = "USB port state";
			perm = INDIGO_RO_PERM;
			item PB_USB_STATE_1 {
				name = AUX_USB_PORT_STATE_1_ITEM_NAME;
