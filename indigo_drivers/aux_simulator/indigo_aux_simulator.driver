				name = AUX_USB_PORT_STATE_2_ITEM_NAME;
				label = "USB port #2";
				value = INDIGO_OK_STATE;
			}
			item PB_USB_STATE_3 {
				name = AUX_USB_PORT_STATE_3_ITEM_NAME;
				label = "USB port #3";
