	aux {
		id = sqm;
		name = "SQM Simulator";
		interface = INDIGO_INTERFACE_AUX_SQM;
		on_attach {
			DEVICE_PORT_PROPERTY->hidden = true;
			DEVICE_PORTS_PROPERTY->hidden = true;
		}
		on_connect {
			sqm_refresh(device, false);
		}
		number SQM_INPUT {
			name = "X_SIMULATION_PARAMETERS";
			group = "Simulation";
			label = "Simulated sky quality";
			on_change {
				sqm_refresh(device, true);
			}
			item SQM_INPUT_BRIGHTNESS {
				name = AUX_WEATHER_SKY_BRIGHTNESS_ITEM_NAME;
				label = "Sky brightness [mag/arcsec^2]";
				value = 21.5;
				min = 0;
				max = 25;
				step = 0;
			}
			item SQM_INPUT_TEMPERATURE {
				name = AUX_WEATHER_SKY_TEMPERATURE_ITEM_NAME;
				label = "Sensor temperature [C]";
				value = 10;
				min = -50;
				max = 100;
				step = 0;
			}
		}
		number SQM_WEATHER {
			name = AUX_WEATHER_PROPERTY_NAME;
			group = "Main";
			label = "Sky quality";
			perm = INDIGO_RO_PERM;
			item SQM_BRIGHTNESS {
				name = AUX_WEATHER_SKY_BRIGHTNESS_ITEM_NAME;
				label = "Sky brightness [mag/arcsec^2]";
				value = 21.5;
				min = 0;
				max = 25;
				step = 0;
			}
			item SQM_TEMPERATURE {
				name = AUX_WEATHER_SKY_TEMPERATURE_ITEM_NAME;
				label = "Sensor temperature [C]";
				value = 10;
				min = -50;
				max = 100;
				step = 0;
			}
			item SQM_BORTLE {
				name = AUX_WEATHER_SKY_BORTLE_CLASS_ITEM_NAME;
				label = "Bortle class";
				value = 0;
				min = 1;
				max = 9;
				step = 1;
			}
		}
	}
	aux {
		id = flat;
		name = "Flat Panel Simulator";
		interface = INDIGO_INTERFACE_AUX_DUSTCAP | INDIGO_INTERFACE_AUX_LIGHTBOX;
		on_attach {
			DEVICE_PORT_PROPERTY->hidden = true;
			DEVICE_PORTS_PROPERTY->hidden = true;
		}
		on_connect {
			indigo_set_switch(FLAT_COVER_PROPERTY, PRIVATE_DATA->cover_open ? FLAT_OPEN_ITEM : FLAT_CLOSE_ITEM, true);
			FLAT_COVER_PROPERTY->state = INDIGO_OK_STATE;
		}
		on_disconnect {
			// The generated connection handler cancels delayed work before deleting properties.
			indigo_set_switch(FLAT_COVER_PROPERTY, PRIVATE_DATA->cover_open ? FLAT_OPEN_ITEM : FLAT_CLOSE_ITEM, true);
			FLAT_COVER_PROPERTY->state = INDIGO_OK_STATE;
		}
		switch FLAT_LIGHT {
			name = AUX_LIGHT_SWITCH_PROPERTY_NAME;
			group = "Main";
			label = "Light on/off";
			rule = INDIGO_ONE_OF_MANY_RULE;
			on_change {
			}
			item FLAT_LIGHT_ON {
				name = AUX_LIGHT_SWITCH_ON_ITEM_NAME;
				label = "On";
				value = false;
			}
			item FLAT_LIGHT_OFF {
				name = AUX_LIGHT_SWITCH_OFF_ITEM_NAME;
				label = "Off";
				value = true;
			}
		}
		number FLAT_INTENSITY {
			name = AUX_LIGHT_INTENSITY_PROPERTY_NAME;
			group = "Main";
			label = "Light intensity [%]";
			on_change {
			}
			item FLAT_INTENSITY {
				name = AUX_LIGHT_INTENSITY_ITEM_NAME;
				label = "Intensity [%]";
				value = 50;
				min = 0;
				max = 100;
				step = 1;
			}
		}
		switch FLAT_COVER {
			name = AUX_COVER_PROPERTY_NAME;
			group = "Main";
			label = "Cover open/close";
			rule = INDIGO_ONE_OF_MANY_RULE;
			on_change {
				if (indigo_get_switch_target(FLAT_COVER_PROPERTY, AUX_COVER_OPEN_ITEM_NAME) == PRIVATE_DATA->cover_open) {
					INDIGO_UPDATE_PROPERTY_STATE(FLAT_COVER_PROPERTY, INDIGO_OK_STATE, NULL);
				} else {
					INDIGO_UPDATE_PROPERTY_STATE(FLAT_COVER_PROPERTY, INDIGO_BUSY_STATE, NULL);
					indigo_execute_handler_in(device, 1, flat_cover_finalizer);
				}
			}
			item FLAT_OPEN {
				name = AUX_COVER_OPEN_ITEM_NAME;
				label = "Open";
				value = false;
			}
			item FLAT_CLOSE {
				name = AUX_COVER_CLOSE_ITEM_NAME;
				label = "Close";
				value = true;
			}
		}
	}
}
