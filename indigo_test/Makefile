# A physically connected SynScan mount is opt-in and excluded from normal integration tests. The
# mount is reached over the network; SYNSCAN_HW_URL selects the address and defaults to
# synscan://, which exercises the driver's UDP autodetection. The test physically moves both axes.
# Set SYNSCAN_HW_AUTOHOME=1 to additionally run the controller autohome procedure, which drives
# both axes to their home index.
.PHONY: test-aux-rpio-hw test-aux-asiair-hw test-mount-synscan-hw
test-mount-synscan-hw: check-lib $(TEST_BUILD)/hardware/test_mount_synscan_hw
	$(TEST_BUILD)/hardware/test_mount_synscan_hw --run

# The physical Raspberry Pi GPIO test switches all eight outputs of the 40-pin
# header, so it is opt-in and nothing may be connected to the header. It runs
# only on a Raspberry Pi and verifies every pin through the pinctrl tool rather
# than through the sysfs files the driver writes.
test-aux-rpio-hw: check-lib $(TEST_BUILD)/hardware/test_aux_rpio_hw
	$(TEST_BUILD)/hardware/test_aux_rpio_hw --run

$(TEST_BUILD)/hardware/test_aux_rpio_hw: hardware/test_aux_rpio_hw.c test_runner.h ../build/drivers/indigo_aux_rpio.a Makefile | $(TEST_BUILD)/hardware
	$(CC) $(TEST_CFLAGS) $< ../build/drivers/indigo_aux_rpio.a -o $@ $(TEST_LDFLAGS)

# The physical ASIAIR power port test switches all four ports of the 40-pin
# header, so it is opt-in and nothing may be connected to the header. It runs on
# a bare Raspberry Pi as well, because the ports are ordinary header pins.
test-aux-asiair-hw: check-lib $(TEST_BUILD)/hardware/test_aux_asiair_hw
	$(TEST_BUILD)/hardware/test_aux_asiair_hw --run

$(TEST_BUILD)/hardware/test_aux_asiair_hw: hardware/test_aux_asiair_hw.c test_runner.h ../build/drivers/indigo_aux_asiair.a Makefile | $(TEST_BUILD)/hardware
	$(CC) $(TEST_CFLAGS) $< ../build/drivers/indigo_aux_asiair.a -o $@ $(TEST_LDFLAGS)

