# The Raspberry Pi GPIO driver reaches the hardware only through sysfs files, so
# the whole boundary is replaced by the fake in test_aux_rpio_sysfs.c. stat is
# replaced through a function-like macro so that struct stat is left alone.
AUX_RPIO_SYSFS_TEST_REPLACEMENTS = -Dopen=sysfs_test_open -Dclose=sysfs_test_close -Dread=sysfs_test_read -Dwrite=sysfs_test_write -Dopendir=sysfs_test_opendir -Dreaddir=sysfs_test_readdir -Dclosedir=sysfs_test_closedir -D'stat(path,buffer)=sysfs_test_stat(path,buffer)' -Dindigo_usleep=sysfs_test_usleep
AUX_RPIO_SYSFS_TEST_CFLAGS = $(TEST_CFLAGS) $(AUX_RPIO_SYSFS_TEST_REPLACEMENTS)

$(INTEGRATION_BUILD)/aux_rpio_sysfs.o: ../indigo_linux_drivers/aux_rpio/indigo_aux_rpio.c ../indigo_linux_drivers/aux_rpio/shared/rpio_sysfs.h ../indigo_linux_drivers/aux_rpio/shared/rpio_sysfs.c Makefile | $(INTEGRATION_BUILD)
	$(CC) $(AUX_RPIO_SYSFS_TEST_CFLAGS) -c $< -o $@

$(INTEGRATION_BUILD)/test_aux_rpio_sysfs: integration/test_aux_rpio_sysfs.c $(INTEGRATION_BUILD)/aux_rpio_sysfs.o integration/sysfs_gpio_fake.h integration/serial_simulator_test_common.h integration/simulator_test_common.h test_runner.h Makefile | $(INTEGRATION_BUILD)
	$(CC) $(TEST_CFLAGS) $< $(INTEGRATION_BUILD)/aux_rpio_sysfs.o -o $@ $(TEST_LDFLAGS)

$(INTEGRATION_BUILD)/aux_rpio_sysfs_asan.o: ../indigo_linux_drivers/aux_rpio/indigo_aux_rpio.c ../indigo_linux_drivers/aux_rpio/shared/rpio_sysfs.h ../indigo_linux_drivers/aux_rpio/shared/rpio_sysfs.c Makefile | $(INTEGRATION_BUILD)
	$(CC) $(AUX_RPIO_SYSFS_TEST_CFLAGS) -O1 -fsanitize=address,undefined -fno-omit-frame-pointer -c $< -o $@

$(INTEGRATION_BUILD)/test_aux_rpio_sysfs_asan: integration/test_aux_rpio_sysfs.c $(INTEGRATION_BUILD)/aux_rpio_sysfs_asan.o integration/serial_simulator_test_common.h integration/simulator_test_common.h test_runner.h Makefile | $(INTEGRATION_BUILD)
	$(CC) $(TEST_CFLAGS) -O1 -fsanitize=address,undefined -fno-omit-frame-pointer $< $(INTEGRATION_BUILD)/aux_rpio_sysfs_asan.o -o $@ $(TEST_LDFLAGS) -fsanitize=address,undefined

